{
  "name": "jobtrack",
  "version": "0.1.0",
  "private": true,
  "description": "Production-quality Job Application Tracker with Kanban, Analytics, Interviews, and Dual Demo/Personal Modes",
  "repository": {
    "type": "git",
    "url": "https://github.com/Omar0Gamal/JobTrack.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
