# ============================================================================
# JobTrack Environment Configuration (.env.example)
# Copy this file to .env and fill in the values for your environment.
# NEVER commit your real .env or .env.local file.
# ============================================================================

# PostgreSQL connection string (e.g., Neon serverless Postgres or local Docker Postgres).
# IMPORTANT: Use two separate databases for your Demo deployment and Personal deployment.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobtrack_dev?schema=public"

# Application operating mode: "demo" (public portfolio with guest sessions) or "personal" (private OAuth tracker).
APP_MODE="demo"

# Secret used by Auth.js v5 for session encryption and in demo mode for HMAC signing of guest cookies.
# Generate with: npx auth secret  OR  openssl rand -base64 32
AUTH_SECRET="replace-with-a-secure-32-byte-minimum-random-secret-string"

# GitHub OAuth credentials for Auth.js v5 (used when APP_MODE="personal").
# Create an OAuth App at https://github.com/settings/developers
AUTH_GITHUB_ID="placeholder-github-client-id"
AUTH_GITHUB_SECRET="placeholder-github-client-secret"

# Optional Google OAuth credentials for Auth.js v5 (used when APP_MODE="personal").
AUTH_GOOGLE_ID="placeholder-google-client-id"
AUTH_GOOGLE_SECRET="placeholder-google-client-secret"

# Comma-separated allowlist of email addresses permitted to sign in when APP_MODE="personal".
# Anyone not in this list is rejected at sign-in so strangers cannot create accounts.
ALLOWED_EMAILS="you@example.com,alternate@example.com"

# Secret bearer token used to authorize requests to /api/cron/cleanup (deletes guest accounts > 7 days old).
CRON_SECRET="replace-with-a-random-cron-bearer-secret"
